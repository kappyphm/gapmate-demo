# ============================================================
# GapMate environment template
# Copy to .env and fill real values. NEVER commit .env
# ============================================================

# --- LLM / Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Database ---
POSTGRES_USER=gapmate
POSTGRES_PASSWORD=gapmate
POSTGRES_DB=gapmate
DATABASE_URL=postgresql+asyncpg://gapmate:gapmate@postgres:5432/gapmate

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Internal service-to-service ---
ANALYSIS_API_URL=http://analysis_api:8001
INTERNAL_API_KEY=change-me-internal-key

# --- Web (Vite) ---
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Ports (host) ---
CORE_API_PORT=8000
ANALYSIS_API_PORT=8001
WEB_PORT=5173
